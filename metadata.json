{
  "name": "icann-nsd",
  "version": "0.6.0",
  "author": "john.bond@icann.org",
  "summary": "puppet module to manage NSD",
  "license": "Apache-2.0",
  "source": "https://github.com/icann-dns/puppet-nsd",
